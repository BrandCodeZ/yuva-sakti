# ---------------------------------------------------------------------------
# Copy to .env (api) and .env.local (web). Never commit the real files.
# ---------------------------------------------------------------------------

# --- API (Express + MongoDB) ------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/yuva_shakti_run

# On Atlas use the plain mongodb+srv:// form. Two Atlas-specific notes:
#   - The database user must be created with SCRAM-SHA-256 (the current
#     default). A user created with SCRAM-SHA-1 fails with a bare
#     "connection closed", so add &authMechanism=SCRAM-SHA-1 if needed.
#   - Add the server's public IP under Network Access in the Atlas dashboard,
#     or every connection is refused at the handshake.
#
# If your network's DNS resolver refuses _mongodb._tcp lookups (some ISPs do),
# the +srv form cannot work. Resolve the SRV record once through any other
# resolver and list the hosts directly instead:
#   mongodb://user:pass@host-00:27017,host-01:27017/?authSource=admin&tls=true

# HMAC key for OTP codes. Generate one and keep it constant, or codes issued
# before a change stop verifying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# HTTP relay for verification SMS (MSG91, Gupshup, Textlocal or similar).
# Leave blank in development and codes are logged instead of sent.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=

# Comma-separated browser origins allowed to post to the API.
CORS_ORIGINS=http://localhost:3000

# The web app's public origin, used to build links inside confirmation emails.
WEB_URL=http://localhost:3000

# Where contact and partnership enquiries are also sent. Leave blank to skip.
ORGANISER_EMAIL=

# Mail delivery. Without a key, emails are logged to the console in
# development and the API refuses to start in production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Yuva Shakti Run <no-reply@yourdomain.in>"

# Set to false to close submissions without redeploying.
ACCEPT_SUBMISSIONS=true

# Mirrors registrationOpen in web/src/config/event.ts. While false, interest,
# notify, contact, volunteer and partner forms stay open but full registrations
# are rejected with 503. Change both when you flip modes.
REGISTRATION_OPEN=false

# Keep false until a timing file is loaded and results are genuinely public.
RESULTS_PUBLISHED=false

# ISO date of the race, used for age checks and certificates.
# Example: 2026-11-29T06:30:00+05:30
EVENT_DATE_ISO=

# --- Web (Next.js) ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: mirror the race date here so the browser-side under-18 check
# matches the server's before the config file is edited.
# NEXT_PUBLIC_EVENT_DATE=
